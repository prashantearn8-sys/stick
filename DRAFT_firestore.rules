rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRestorationJob(data) {
      return data.keys().hasAll([
          'ownerId',
          'fileName',
          'source',
          'width',
          'height',
          'regionCount',
          'watermarkType',
          'restorationMethod',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'fileName',
          'source',
          'width',
          'height',
          'regionCount',
          'watermarkType',
          'restorationMethod',
          'status',
          'driveFileId',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId == request.auth.uid
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.source is string
        && (data.source == 'local' || data.source == 'drive')
        && data.width is int
        && data.width >= 1
        && data.width <= 16384
        && data.height is int
        && data.height >= 1
        && data.height <= 16384
        && data.regionCount is int
        && data.regionCount >= 0
        && data.regionCount <= 500
        && data.watermarkType is string
        && data.watermarkType.size() >= 1
        && data.watermarkType.size() <= 120
        && data.restorationMethod is string
        && data.restorationMethod.size() >= 1
        && data.restorationMethod.size() <= 120
        && data.status is string
        && (
          data.status == 'detected'
          || data.status == 'restored'
          || data.status == 'exported_drive'
        )
        && (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /restorationJobs/{jobId} {
      allow get: if isSignedIn() && isValidId(jobId) && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(jobId)
        && isValidRestorationJob(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(jobId)
        && isValidRestorationJob(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'exported_drive'
        && (
          // Action 1: Update restoration progress/results
          incoming().diff(existing()).affectedKeys().hasOnly([
            'regionCount',
            'watermarkType',
            'restorationMethod',
            'status',
            'driveFileId',
            'updatedAt'
          ])
          ||
          // Action 2: Mark job exported to Google Drive
          (
            incoming().status == 'exported_drive'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'driveFileId',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isValidId(jobId) && existing().ownerId == request.auth.uid;
    }
  }
}
